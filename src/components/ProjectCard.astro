---
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  project: any;
}
const { project } = Astro.props;
const pageLang = getLangFromUrl(Astro.url);
const p = project.data;
---

<a
  href={`/${pageLang}/projects/${p.url}/`}
  class="group panel p-4 flex items-center gap-4 hover:border-signal transition-colors"
>
  <div class="w-20 h-16 shrink-0 rounded overflow-hidden bg-panel-2">
    <img
      src={p.image.url}
      alt={p.image.alt}
      loading="lazy"
      class="w-full h-full object-cover"
    />
  </div>
  <div class="min-w-0">
    <h3 class="font-medium truncate group-hover:text-signal transition-colors">
      {p.title}
    </h3>
    <p class="text-muted text-sm truncate">{p.summary}</p>
  </div>
</a>
