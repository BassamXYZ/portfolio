---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Social from "./Social.astro";
import { person } from "../data/site";

const pageLang = getLangFromUrl(Astro.url);
const t = useTranslations(pageLang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line mt-20">
  <div
    class="max-w-6xl mx-auto px-5 sm:px-8 py-10 flex flex-col items-center gap-4 text-center"
  >
    <a
      href={`mailto:${person.email}`}
      class="text-paper hover:text-signal transition-colors"
    >
      {person.email}
    </a>

    <div class="flex">
      <Social url={person.social.github} label="GitHub">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="currentColor"
        >
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.41-2.7 5.39-5.26 5.67.41.36.78 1.06.78 2.14 0 1.54-.01 2.79-.01 3.17 0 .31.21.67.8.56A10.51 10.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          ></path>
        </svg>
      </Social>
      <Social url={person.social.linkedin} label="LinkedIn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="currentColor"
        >
          <path
            d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45Z"
          ></path>
        </svg>
      </Social>
      <Social
        url={pageLang === "ar"
          ? "https://bassamahmad.com/ar/rss.xml"
          : "https://bassamahmad.com/en/rss.xml"}
        label="RSS"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="currentColor"
        >
          <circle cx="5" cy="19" r="2"></circle>
          <path
            d="M4 10a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7v-3ZM4 3a17 17 0 0 1 17 17h-3A14 14 0 0 0 4 6V3Z"
          ></path>
        </svg>
      </Social>
    </div>

    <p class="label">
      &copy; {year}
      {t("name")}
    </p>
  </div>
</footer>
