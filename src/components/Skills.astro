---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { skillGroups, alsoComfortableWith } from "../data/skills";

const pageLang = getLangFromUrl(Astro.url);
const t = useTranslations(pageLang);
const groups = skillGroups[pageLang];
---

<section class="max-w-6xl mx-auto py-14 border-t border-line">
  <h2 class="text-2xl font-semibold mb-8">{t("skills.title")}</h2>
  <div class="grid sm:grid-cols-2 gap-6">
    {
      groups.map((g) => (
        <div class="panel p-5">
          <p class="label mb-3">{g.group}</p>
          <div class="flex flex-wrap gap-2">
            {g.items.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  <p class="text-sm text-muted mt-6 max-w-[70ch]">
    {alsoComfortableWith[pageLang]}
  </p>
</section>
