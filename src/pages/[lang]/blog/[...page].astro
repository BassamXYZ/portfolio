---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { useTranslations } from "../../../i18n/utils";

export async function getStaticPaths({ paginate }: any) {
  const allLanguages = ["ar", "en"];
  const posts = await getCollection("blog");

  return allLanguages.flatMap((lang) => {
    const filtered = posts
      .filter((post) => post.id.startsWith(`${lang}/`))
      .sort(
        (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
      );
    return paginate(filtered, { params: { lang }, pageSize: 12 });
  });
}

const { page } = Astro.props as any;
const { lang } = Astro.params as { lang: "en" | "ar" };
const t = useTranslations(lang);

const data = {
  title: t("nav.blog"),
  description:
    lang === "ar"
      ? "مدونة شخصية عن البرمجة والرياضيات والتكنولوجيا."
      : "Personal blog about programming, math, and technology.",
  author: t("name"),
};
---

<BaseLayout data={data}>
  <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-10">
    {t("nav.blog")}
  </h1>

  <div class="max-w-3xl mx-auto grid gap-4">
    {
      page.data.map((post: any) => (
        <a
          href={`/${lang}/blog/${post.id.split("/")[1]}/`}
          class="panel p-5 flex flex-col gap-2 hover:border-signal transition-colors"
        >
          <p class="label">{post.data.date.slice(0, 10)}</p>
          <h2 class="text-xl font-semibold">{post.data.title}</h2>
          <p class="text-muted text-sm">{post.data.description}</p>
        </a>
      ))
    }
  </div>

  {
    (page.url.next || page.url.prev) && (
      <div class="max-w-3xl mx-auto flex justify-between mt-8">
        {page.url.prev ? (
          <a href={page.url.prev} class="btn">
            {t("prev")}
          </a>
        ) : (
          <span />
        )}
        {page.url.next && (
          <a href={page.url.next} class="btn">
            {t("next")}
          </a>
        )}
      </div>
    )
  }
</BaseLayout>
