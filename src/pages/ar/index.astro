---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Skills from "../../components/Skills.astro";
import FeaturedProject from "../../components/FeaturedProject.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations("ar");

const allProjects = await getCollection("projects", ({ id }) =>
  id.startsWith("ar/"),
);
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const other = allProjects
  .filter((p) => !p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const data = {
  title: "مهندس ميكاترونكس -- ذكاء اصطناعي وروبوتات",
  description:
    "الموقع الشخصي لبسام أحمد، مهندس ميكاترونكس متخصص في الذكاء الاصطناعي والرؤية الحاسوبية والأنظمة المستقلة والروبوتات.",
  tags: [
    "مهندس ميكاترونكس",
    "رؤية حاسوبية",
    "روبوتات",
    "ROS2",
    "أنظمة مستقلة",
    "مهندس ذكاء اصطناعي",
  ],
  author: "بسام أحمد",
};
---

<BaseLayout data={data}>
  <Hero />

  <section class="max-w-6xl mx-auto py-14 border-t border-line">
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="text-2xl font-semibold">{t("projects.featured")}</h2>
      <a href="/ar/projects/" class="label hover:text-signal transition-colors">
        {t("projects.viewAll")} &larr;
      </a>
    </div>
    <div class="grid gap-5">
      {featured.map((p) => <FeaturedProject project={p} />)}
    </div>

    {
      other.length > 0 && (
        <div class="mt-6 grid sm:grid-cols-2 gap-4">
          {other.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      )
    }
  </section>

  <Skills />
</BaseLayout>
