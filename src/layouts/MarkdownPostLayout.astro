---
import BaseLayout from "./BaseLayout.astro";
const { data } = Astro.props;
data.pageType = "article";
---

<BaseLayout data={data}>
  <article class="max-w-3xl mx-auto">
    <p class="label mb-2">{data.date?.slice(0, 10)}</p>
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-8">
      {data.title}
    </h1>
    {
      data.image?.url && (
        <img
          src={data.image.url}
          alt={data.image.alt}
          class="w-full rounded-lg border border-line mb-8"
        />
      )
    }
    <div class="prose prose-invert prose-portfolio">
      <slot />
    </div>
  </article>
</BaseLayout>
