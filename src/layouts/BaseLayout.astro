---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { person } from "../data/site";

interface Props {
  data: {
    title: string;
    description: string;
    pageType?: "website" | "article";
    tags?: string[];
    author?: string;
    date?: string;
    image?: { url: string; alt: string };
    schema?: Record<string, any>;
  };
}

const { data } = Astro.props;
const pageLang = getLangFromUrl(Astro.url);
const t = useTranslations(pageLang);

const siteTitle = `${data.title} | ${t("name")}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  data.image?.url || "/images/og-default.png",
  Astro.site,
).toString();

// Every route in this site mirrors 1:1 between /en/ and /ar/ (same slugs for
// posts and projects), so the alternate-language URL is just the same path
// with the leading locale segment swapped.
const otherLang = pageLang === "en" ? "ar" : "en";
const alternatePath = Astro.url.pathname.replace(
  /^\/(en|ar)(\/|$)/,
  `/${otherLang}$2`,
);
const alternateURL = new URL(alternatePath, Astro.site).toString();
const ogLocale = pageLang === "ar" ? "ar_AR" : "en_US";
const ogLocaleAlt = pageLang === "ar" ? "en_US" : "ar_AR";
---

<!doctype html>
<html lang={pageLang} dir={t("direction")} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e1116" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t("name")}
      href={`https://bassamahmad.com/${pageLang}/rss.xml`}
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={pageLang === "ar" ? "ar" : "en"} href={canonicalURL} />
    <link rel="alternate" hreflang={otherLang === "ar" ? "ar" : "en"} href={alternateURL} />
    <link rel="alternate" hreflang="x-default" href={pageLang === "en" ? canonicalURL : alternateURL} />

    <title>{siteTitle}</title>
    <meta name="description" content={data.description} />
    {data.tags && <meta name="keywords" content={data.tags.join(", ")} />}
    <meta name="author" content={data.author || t("name")} />

    <meta property="og:type" content={data.pageType || "website"} />
    <meta property="og:site_name" content={t("name")} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={data.description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={data.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@Bassam_XYZ" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Bassam Ahmad",
        url: "https://bassamahmad.com/",
        email: `mailto:${person.email}`,
        jobTitle: "Mechatronics Engineer",
        sameAs: Object.values(person.social),
      })}
    />
    {
      data.schema && (
        <script type="application/ld+json" set:html={JSON.stringify(data.schema)} />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full px-5 sm:px-8 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
